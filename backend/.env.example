# App
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://bloei:bloei_dev@localhost:5432/bloei_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AI — Anthropic (Claude) for Bloem
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Social platform OAuth credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email (Resend — Dutch-friendly)
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=noreply@bloei.nl

# Frontend
FRONTEND_URL=http://localhost:3000

# Encryption (for storing OAuth tokens)
ENCRYPTION_KEY=change_me_32_byte_hex_key_here_!!
